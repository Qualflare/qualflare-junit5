<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>qf.fixture</groupId><artifactId>junit5-fixture</artifactId><version>1.0</version>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Overridden by the CI compatibility matrix, which runs this fixture against
         JUnit 5.12, 5.13 and 6.x to make the one-build-serves-both claim true. -->
    <junit.jupiter.version>5.12.2</junit.jupiter.version>
    <junit.platform.version>1.12.2</junit.platform.version>
    <!-- Passed in by verify.py, read from the ROOT pom. Hardcoding it meant the fixture
         asked for 0.1.0-SNAPSHOT after `versions:set` had produced 0.1.0, and the release
         gate failed with "no report written" instead of naming the missing artifact. -->
    <qualflare.version>0.2.0-SNAPSHOT</qualflare.version>
    <!-- Surefire changed how it scopes launcher sessions in 3.5.4: up to 3.5.3 it opened
         one session per rerun, from 3.5.4 one session covers all of them. Both models have
         to produce the same report, so CI runs this fixture against one version either
         side of that line. -->
    <surefire.version>3.5.6</surefire.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
      <version>${junit.jupiter.version}</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.qualflare</groupId><artifactId>qualflare-junit5</artifactId>
      <version>${qualflare.version}</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId><artifactId>junit-platform-launcher</artifactId>
      <version>${junit.platform.version}</version><scope>test</scope>
    </dependency>
  </dependencies>
  <build><plugins>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
      <version>${surefire.version}</version>
      <configuration>
        <rerunFailingTestsCount>3</rerunFailingTestsCount>
        <testFailureIgnore>true</testFailureIgnore>
      </configuration>
    </plugin>
  </plugins></build>
</project>
